@model Category
@* When you pass asp-for then you do not need to pass the name and the type properties as it will automatikcally find the name. *@
@* You can also add asp-for in the label so that you do not define the label statically. *@
@* The labels will use the display name defined in the model. Check the modelname and the property called DisplayName  *@
@* We now introduce asp-validation-for which validates the fields against the Model and gives the error. *@
@* Ensure when using asp-for to not include the value tag as this will mess up your data population in case of an error  *@
<div class="container">
    <div class="row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Create Category</h2>
        </div>
    </div>

    @* for all validation errors, we use validation summary. If we pass All, it will display all errors *@
    @* if we set it to ModelOnly, it will only display the model related errors  *@

    <div asp-validation-summary="ModelOnly" class="text-danger" style="list-style-type: none"></div>

    <form method="post">
    <div class="border p-3 mt-4">
        <div class="mb-3 row">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
            <div class="mb-3 row">
                <label asp-for="DisplayOrder""></label>
                <input asp-for="DisplayOrder" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-6 col-md-3">
                    <button type="submit" class="btn btn-primary form-control" style="width:150px">Create</button>
                </div>
                <div class="col-6 col-md-3">
                    <a class="btn btn-secondary" asp-controller="Category" asp-action="Index">Back to List</a>
                </div>
            </div>
    </div>    
    </form>

    @section Scripts{
        @{
            <partial name="_ValidationScriptsPartial" />
        }
    }
</div>